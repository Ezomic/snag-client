{
    "name": "thijssensoftware/snag-client",
    "description": "Prints the snag reporter widget into a host app, with the reporter pseudonym and signature computed server-side.",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "thijssensoftware/request-id": "^0.1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Ezomic/request-id.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Thijssensoftware\\SnagClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thijssensoftware\\SnagClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thijssensoftware\\SnagClient\\SnagClientServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
